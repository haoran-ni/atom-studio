<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/qml">
        <file alias="Main.qml">../src/ui/qml/Main.qml</file>
        <file alias="HeaderBar.qml">../src/ui/qml/HeaderBar.qml</file>
        <file alias="Sidebar.qml">../src/ui/qml/Sidebar.qml</file>
        <file alias="ViewportPanel.qml">../src/ui/qml/ViewportPanel.qml</file>
        <file alias="CollapsibleSection.qml">../src/ui/qml/CollapsibleSection.qml</file>
        <file alias="PropertyRow.qml">../src/ui/qml/PropertyRow.qml</file>
        <file alias="NumericSliderControl.qml">../src/ui/qml/NumericSliderControl.qml</file>
        <file alias="RGBColorPicker.qml">../src/ui/qml/RGBColorPicker.qml</file>
        <file alias="InfoOverlayBox.qml">../src/ui/qml/InfoOverlayBox.qml</file>
        <file alias="AppMenuActions.qml">../src/ui/qml/AppMenuActions.qml</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="background.svg">icons/background.svg</file>
        <file alias="camera.svg">icons/camera.svg</file>
        <file alias="export.svg">icons/export.svg</file>
        <file alias="files.svg">icons/files.svg</file>
        <file alias="import.svg">icons/import.svg</file>
        <file alias="chevron-down.svg">icons/chevron-down.svg</file>
        <file alias="chevron-left.svg">icons/chevron-left.svg</file>
        <file alias="chevron-right.svg">icons/chevron-right.svg</file>
        <file alias="chevron-up.svg">icons/chevron-up.svg</file>
        <file alias="info.svg">icons/info.svg</file>
        <file alias="manipulation.svg">icons/manipulation.svg</file>
        <file alias="render.svg">icons/render.svg</file>
        <file alias="reset.svg">icons/reset.svg</file>
        <file alias="unit-cell.svg">icons/unit-cell.svg</file>
        <file alias="visualization.svg">icons/visualization.svg</file>
    </qresource>
    <qresource prefix="/branding">
        <file alias="app-logo.png">temp_logo.png</file>
    </qresource>
</RCC>
