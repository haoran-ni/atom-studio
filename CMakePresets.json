{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        }
      }
    },
    {
      "name": "unix-make-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": {
          "value": "/usr/bin/make",
          "type": "FILEPATH"
        }
      }
    },
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default local build using system-installed Qt",
      "inherits": "unix-make-base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release Config",
      "description": "Release local build using system-installed Qt",
      "inherits": "unix-make-base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-default",
      "displayName": "vcpkg Debug Config",
      "description": "Debug build using vcpkg toolchain",
      "inherits": "vcpkg-base",
      "binaryDir": "${sourceDir}/build-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-release",
      "displayName": "vcpkg Release Config",
      "description": "Release build using vcpkg toolchain",
      "inherits": "vcpkg-base",
      "binaryDir": "${sourceDir}/build-vcpkg-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "system-qt",
      "displayName": "System Qt Config",
      "description": "Build using system-installed Qt (no vcpkg)",
      "inherits": "unix-make-base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "system-qt-release",
      "displayName": "System Qt Release Config",
      "description": "Release build using system-installed Qt",
      "inherits": "unix-make-base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "vcpkg-default",
      "configurePreset": "vcpkg-default"
    },
    {
      "name": "vcpkg-release",
      "configurePreset": "vcpkg-release"
    },
    {
      "name": "system-qt",
      "configurePreset": "system-qt"
    },
    {
      "name": "system-qt-release",
      "configurePreset": "system-qt-release"
    }
  ]
}
